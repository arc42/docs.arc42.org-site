---
---
[
{%- for post in site.posts -%}
{% unless forloop.first %},{% endunless %}
{"type":"tip","title":{{ post.title | jsonify }},"author":{{ post.author | jsonify }},"tags":{{ post.tags | jsonify }},"url":{{ post.url | jsonify }},"date":{{ post.date | date: '%Y-%m-%d' | jsonify }},"content":{{ post.content | strip_html | strip_newlines | jsonify }}}
{%- endfor -%}
{%- assign index_pages = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.hide != true" -%}
{%- for p in index_pages -%}
,{"type":{% if p.url contains '/section-' %}"section"{% else %}"page"{% endif %},"title":{{ p.title | jsonify }},"tags":{{ p.tags | jsonify }},"url":{{ p.url | jsonify }},"content":{{ p.content | strip_html | strip_newlines | jsonify }}}
{%- endfor -%}
{%- assign index_examples = site.examples | where_exp: "e", "e.title" -%}
{%- for e in index_examples -%}
,{"type":"example","title":{{ e.title | jsonify }},"tags":{{ e.tags | jsonify }},"url":{{ e.url | jsonify }},"content":{{ e.content | strip_html | strip_newlines | jsonify }}}
{%- endfor -%}
]
